# SQL connection details shared by passdb and userdb.

driver = mysql
connect = host=127.0.0.1 dbname=mailserver user=mailuser password=mailuser_strong_password

# Passwords are stored as SHA512-CRYPT hashes generated via doveadm/crypt.
default_pass_scheme = SHA512-CRYPT

password_query = SELECT email AS user, password FROM virtual_users WHERE email='%u';
user_query = \
  SELECT CONCAT('/var/mail/vhosts/internal.invalid/', SUBSTRING_INDEX(email, '@', 1)) AS home, \
         5000 AS uid, 5000 AS gid \
  FROM virtual_users WHERE email='%u';
