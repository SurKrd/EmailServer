# Postfix configuration for IPv6 literal-only closed network
# Each directive is commented to document the rationale for operating without DNS
# and rewriting IPv6 address-literals into a canonical internal domain.

# Basic identity used in message headers and logs.
myhostname = mail-gw.af49.local
myorigin = mail-gw.af49.local

# Listen on all interfaces but use IPv6 exclusively.
inet_interfaces = all
inet_protocols = ipv6
smtp_address_preference = ipv6

# Disable DNS entirely; all routing is static within the trusted subnet.
disable_dns_lookups = yes

# Trust only localhost and the private af49::/16 subnet for relaying.
mynetworks = [::1]/128, af49::/16

# Never append local domain automatically; literals must stay intact.
append_dot_mydomain = no

# Local delivery is handled via the virtual transport to Dovecot. System
# aliases remain available for local service accounts.
mydestination = localhost
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases

# Preserve the original RCPT TO for auditing.
enable_original_recipient = yes

# Require authenticated or on-subnet clients; reject everything else.
smtpd_relay_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination
smtpd_recipient_restrictions = permit_mynetworks, permit_sasl_authenticated, reject

# SASL authentication is provided by Dovecot's auth socket.
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes

# TLS is intentionally disabled because the network is closed and trusted.
smtpd_tls_security_level = none
smtp_tls_security_level = none
lmtp_tls_security_level = none

# Minimal hygiene controls suitable for a lab network.
smtpd_helo_required = yes
disable_vrfy_command = yes
smtpd_banner = $myhostname ESMTP IPv6 literal relay

# Accept only the internal virtual domain managed in MariaDB.
virtual_mailbox_domains = internal.invalid
relay_domains = $virtual_mailbox_domains

# Verify virtual recipients against MariaDB.
virtual_mailbox_maps = mysql:/etc/postfix/mysql-virtual-mailbox-maps.cf

# Rewrite IPv6 address-literals into the canonical internal domain and allow
# any additional alias mappings stored in SQL.
virtual_alias_maps = regexp:/etc/postfix/virtual_ip_literals, mysql:/etc/postfix/mysql-virtual-alias-maps.cf

# Store virtual mailbox metadata under a dedicated vmail UID/GID.
virtual_uid_maps = static:5000
virtual_gid_maps = static:5000
virtual_minimum_uid = 5000
virtual_mailbox_base = /var/mail/vhosts/internal.invalid

# Hand off delivery to Dovecot via LMTP over the private socket.
virtual_transport = lmtp:unix:private/dovecot-lmtp
lmtp_destination_recipient_limit = 1

# Allow plus addressing to keep IPv6 suffixes unique per mailbox.
recipient_delimiter = +

# Ensure Postfix does not try to resolve transport hosts via DNS.
smtp_host_lookup = native
